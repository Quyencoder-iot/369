{
    "unicast": "127.0.0.1",
    "netmask": "255.255.255.0",
    
    "logging": {
        "level": "debug",
        "console": "true",
        "file": {
            "enable": "true",
            "path": "/tmp/vsomeip.log"
        },
        "dlt": "false"
    },
    
    "applications": [
        {
            "name": "hello_service",
            "id": "0x1111",
            "max_dispatchers": "10",
            "max_dispatch_time": "100"
        },
        {
            "name": "hello_client",
            "id": "0x2222",
            "max_dispatchers": "10",
            "max_dispatch_time": "100"
        }
    ],
    
    "services": [
        {
            "service": "0x1234",
            "instance": "0x5678",
            "unreliable": "30509",
            "reliable": {
                "port": "30510",
                "enable-magic-cookies": "false"
            },
            "events": [
                {
                    "event": "0x8001",
                    "is_field": "true",
                    "is_reliable": "false",
                    "update-cycle": "1000"
                }
            ],
            "eventgroups": [
                {
                    "eventgroup": "0x0001",
                    "events": ["0x8001"],
                    "is_multicast": "false"
                }
            ]
        }
    ],
    
    "routing": "hello_service",
    
    "service-discovery": {
        "enable": "true",
        "multicast": "224.244.224.245",
        "port": "30490",
        "protocol": "udp",
        "initial_delay_min": "10",
        "initial_delay_max": "100",
        "repetitions_base_delay": "200",
        "repetitions_max": "3",
        "ttl": "3",
        "cyclic_offer_delay": "2000",
        "request_response_delay": "1500"
    },
    
    "watchdog": {
        "enable": "false",
        "timeout": "5000",
        "allowed_missing_pongs": "3"
    },
    
    "supports_selective_broadcasts": {
        "address": "224.244.224.245"
    }
}
